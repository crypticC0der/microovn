# This is a bash shell fragment -*- bash -*-
load "${ABS_TOP_TEST_DIRNAME}test_helper/setup_teardown/$(basename "${BATS_TEST_FILENAME//.bats/.bash}")"

setup() {
    load ${ABS_TOP_TEST_DIRNAME}test_helper/common.bash
    load ${ABS_TOP_TEST_DIRNAME}test_helper/lxd.bash
    load ${ABS_TOP_TEST_DIRNAME}test_helper/microovn.bash
    load ${ABS_TOP_TEST_DIRNAME}test_helper/bgp_utils.bash

    load ${ABS_TOP_TEST_DIRNAME}../.bats/bats-support/load.bash
    load ${ABS_TOP_TEST_DIRNAME}../.bats/bats-assert/load.bash

    assert [ -n "$TEST_CONTAINER" ]
    assert [ -n "$BGP_PEER" ]
}

teardown() {
    print_diagnostics_on_failure "$TEST_CONTAINER $BGP_PEER"

    local chassis="$TEST_CONTAINER"

    # Reset the FRR peer's running configuration (vtysh is additive).
    lxc_exec "$BGP_PEER" "systemctl restart frr"

    # Reset the underlay back to the seed config on the chassis.
    lxc_exec "$chassis" "rm -f /var/snap/microovn/common/data/bird/underlay.json" || true
    lxc_exec "$chassis" "snap stop microovn.bird" || true
}

# enable_bird_peer_link_local CONTAINER IFACE
#
# Print the IPv6 link-local address of IFACE on CONTAINER.
enable_bird_peer_link_local() {
    local container=$1; shift
    local iface=$1; shift
    lxc_exec "$container" \
        "ip -6 addr show dev $iface | grep -oE 'fe80::[0-9a-f:]+' | head -1"
}

enable_bird_peer_link_local_is_set() {
    local container=$1; shift
    local iface=$1; shift
    [ -n "$(enable_bird_peer_link_local "$container" "$iface")" ]
}

# enable_bird_bgp_established CONTAINER — the spawned underlay BGP session is
# Established. (The parent underlay_0 template stays Passive; the dynamic neighbor
# is spawned as underlay_0_peer_1.)
enable_bird_bgp_established() {
    local container=$1; shift
    lxc_exec "$container" \
        "microovn.birdc show protocols all underlay_0_peer_1 | grep -qE 'BGP state:[[:space:]]*Established'"
}

# enable_bird_bfd_up CONTAINER — a BFD session with the peer is Up.
enable_bird_bfd_up() {
    local container=$1; shift
    lxc_exec "$container" \
        "microovn.birdc show bfd sessions | awk '\$3 == \"Up\"' | grep -q ."
}

enable_bird_register_test_functions() {
    bats_test_function \
        --description "Enable structured underlay BIRD and peer with the fabric" \
        -- enable_underlay
}

# enable_underlay
#
# Bootstrapped node; the FRR peer runs IPv6-unnumbered eBGP on the shared link.
# `microovn enable bird --uplink eth1` renders the typed underlay, persists it,
# and peers with the FRR speaker; the test asserts the config record + render and
# that the underlay_0 BGP session establishes with BFD Up.
enable_underlay() {
    local chassis="$TEST_CONTAINER"
    local tor_asn=4200000100
    local host_asn=4200000006
    local router_id=0.0.0.6

    # Bring the peer's uplink up, start its unnumbered BGP speaker, and have it
    # send RAs so the node's radv router-discovery can learn the peer's LL.
    lxc_exec "$BGP_PEER" "ip link set $BGP_CONTAINER_INT_IFACE up"
    wait_until "enable_bird_peer_link_local_is_set $BGP_PEER $BGP_CONTAINER_INT_IFACE" false 30
    frr_start_bgp_unnumbered "$BGP_PEER" "$tor_asn" "$BGP_CONTAINER_INT_IFACE"
    frr_send_ra "$BGP_PEER" "$BGP_CONTAINER_INT_IFACE" "2001:db8:eb::/64"

    # Bring the chassis uplink up (BIRD peering needs a link-local on it).
    lxc_exec "$chassis" "ip link set $OVN_CONTAINER_INT_IFACE up"
    wait_until "enable_bird_peer_link_local_is_set $chassis $OVN_CONTAINER_INT_IFACE" false 30

    echo "# ($chassis) Enabling the structured underlay on $OVN_CONTAINER_INT_IFACE" >&3
    run lxc_exec "$chassis" \
        "microovn enable bird --uplink $OVN_CONTAINER_INT_IFACE --config asn=$host_asn --config router_id=$router_id"
    assert_success

    # The UnderlayConfig is persisted.
    run lxc_exec "$chassis" "cat /var/snap/microovn/common/data/bird/underlay.json"
    assert_success
    assert_output --partial "\"asn\": \"$host_asn\""
    assert_output --partial "\"$OVN_CONTAINER_INT_IFACE\""

    # The rendered config is underlay-generated and carries one uplink session.
    run lxc_exec "$chassis" \
        "grep -q 'Generated by microovn underlay mode' /var/snap/microovn/common/data/bird/bird.conf"
    assert_success
    run lxc_exec "$chassis" \
        "grep -q 'protocol bgp underlay_0' /var/snap/microovn/common/data/bird/bird.conf && grep -q 'local as $host_asn;' /var/snap/microovn/common/data/bird/bird.conf"
    assert_success

    echo "# ($chassis) Waiting on established underlay BGP with $BGP_PEER" >&3
    wait_until "enable_bird_bgp_established $chassis" false 60

    echo "# ($chassis) Waiting on BFD session with $BGP_PEER" >&3
    wait_until "enable_bird_bfd_up $chassis" false 60
}

enable_bird_register_test_functions